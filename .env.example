# Codex Configuration

# Database ('db' is the Docker Compose service name for PostgreSQL)
DATABASE_URL=postgresql+asyncpg://codex:codex@db:5432/codex

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Audiobookshelf (optional)
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_API_KEY=

# OpenLibrary (no key needed, but rate limiting applies)
OPENLIBRARY_ENABLED=true

# Downloads
DOWNLOAD_DIR=/downloads
TEMP_DIR=/tmp/codex

# Prowlarr (optional)
PROWLARR_URL=
PROWLARR_API_KEY=
